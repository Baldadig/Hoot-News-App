{
  "name": "hoot",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Hoot — een rustige, reclamevrije nieuws-tijdlijn die jouw abonnementen bundelt tot één feed.",
  "scripts": {
    "dev": "vite",
    "netlify-dev": "netlify dev",
    "build": "node scripts/controle-native-runtime.mjs && node scripts/build-site.mjs",
    "preview": "vite preview",
    "gen-icons": "node scripts/gen-icons.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "build:core": "node scripts/build-edition-core.mjs",
    "golden": "node scripts/make-golden.mjs",
    "rood": "node scripts/rood-meting.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/roboto": "5.1.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@netlify/blobs": "^10.7.9",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.118.0",
    "idb-keyval": "6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "satori": "^0.63.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
